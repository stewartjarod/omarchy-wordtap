#!/usr/bin/env bash
# Word Tap: open the popup on the text read from stdin (up to 400 bytes).
#
#   printf '%s' "<word or phrase>" | summon
#
# `omarchy-shell shell summon` hands its payload to `qs ipc call` as an argument, where any local user
# can read it in /proc/<pid>/cmdline, and the text may be a highlighted password. So the text goes
# into a private file under $XDG_RUNTIME_DIR and the payload only says to read it; the popup reads the
# file once and empties it.
set -euo pipefail

# Run under a fixed, trusted PATH and resolve every helper to an absolute path, so a
# hostile entry planted earlier in the user's PATH can never shadow the tools we call.
export PATH=/usr/local/bin:/usr/bin:/bin:/usr/share/omarchy/bin
pin() {  # <command> -> absolute path (or fail loudly)
  local p; p="$(command -v -- "$1" 2>/dev/null || true)"
  [[ -n "$p" && -x "$p" ]] || { printf 'wordtap: required command not found: %s\n' "$1" >&2; exit 127; }
  printf '%s' "$p"
}
HEAD="$(pin head)"; MKDIR="$(pin mkdir)"; CHMOD="$(pin chmod)"; MKTEMP="$(pin mktemp)"; MV="$(pin mv)"
OMARCHY_SHELL="$(pin omarchy-shell)"

plugin_id="stewartjarod.wordtap"
dir="${XDG_RUNTIME_DIR:?XDG_RUNTIME_DIR is not set}/wordtap"

# Our own 0700 directory, never through a planted symlink.
[[ ! -L "$dir" ]] || exit 1
"$MKDIR" -p -- "$dir"
[[ -d "$dir" && ! -L "$dir" && -O "$dir" ]] || exit 1
"$CHMOD" 700 -- "$dir"

# mktemp creates the file 0600; the rename replaces the old handoff atomically.
tmp="$("$MKTEMP" -- "$dir/.query.XXXXXX")"
"$HEAD" -c 400 >"$tmp"
"$MV" -f -- "$tmp" "$dir/query"

"$OMARCHY_SHELL" -q shell summon "$plugin_id" '{"handoff":true}'
