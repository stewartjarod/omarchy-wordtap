#!/usr/bin/env bash
# Word Tap query engine (derived from Look Up by keegan-sucks, MIT).
#
#   dict-lookup "<word or phrase>"
#
# Consults every source listed in `sources` (~/.config/wordtap/config.json,
# else the plugin's defaults.json), in order, and prints a single
# JSON document describing the result. The QML overlay renders whatever this
# returns, so adding a new dictionary is purely a matter of dropping a
# providers/<id>.json descriptor, teaching this script its "kind", and listing
# the id to `sources` — no QML changes required.
#
# Output schema:
# {
#   "query":      "<original query>",
#   "word":       "<normalized primary token>",
#   "found":      true|false,
#   "sections": [ { "id","name","entries":[ {"headword","text"} ] } ],
#   "suggestions":[ "..." ]        // near matches, when the exact word is missing
# }
set -euo pipefail

# Run under a fixed, trusted PATH and resolve every helper to an absolute path, so a
# hostile entry planted earlier in the user's PATH can never shadow the tools we call.
export PATH=/usr/local/bin:/usr/bin:/bin:/usr/share/omarchy/bin
pin() {  # <command> -> absolute path (or fail loudly)
  local p; p="$(command -v -- "$1" 2>/dev/null || true)"
  [[ -n "$p" && -x "$p" ]] || { printf 'wordtap: required command not found: %s\n' "$1" >&2; exit 127; }
  printf '%s' "$p"
}
JQ="$(pin jq)"; SQLITE3="$(pin sqlite3)"; XZ="$(pin xz)"
HEAD="$(pin head)"; WC="$(pin wc)"; MV="$(pin mv)"; RM="$(pin rm)"; MKDIR="$(pin mkdir)"
CHMOD="$(pin chmod)"; MKTEMP="$(pin mktemp)"; DIRNAME="$(pin dirname)"; BASENAME="$(pin basename)"
SED="$(pin sed)"; AWK="$(pin awk)"; TR="$(pin tr)"
CURL="$(pin curl)"; SHA256SUM="$(pin sha256sum)"; FIND="$(pin find)"

# Hard cap on the decompressed dictionary (real DB is ~28 MB); bounds a
# decompression bomb from exhausting storage.
readonly MAX_DB_BYTES=134217728   # 128 MiB

plugin_dir="$(cd "$("$DIRNAME" "${BASH_SOURCE[0]}")/.." && pwd)"
defaults="$plugin_dir/defaults.json"
user_config="${XDG_CONFIG_HOME:-$HOME/.config}/wordtap/config.json"
cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/wordtap"

raw_query="${1:-}"

emit() { printf '%s' "$1"; exit 0; }
fail_empty() {
  emit "$("$JQ" -cn --arg q "$raw_query" '{query:$q, word:"", found:false, sections:[], suggestions:[]}')"
}

# ---- normalize the query -------------------------------------------------
# Keep letters, digits, spaces, apostrophes and hyphens; collapse whitespace.
norm="$(printf '%s' "$raw_query" \
  | "$TR" '[:upper:]' '[:lower:]' \
  | "$TR" -c "a-z0-9'’ -" ' ' \
  | "$TR" -s ' ' \
  | "$SED" -e 's/^ *//' -e 's/ *$//')"
[[ -n "$norm" ]] || fail_empty

first="${norm%% *}"

# Build an ordered, de-duplicated list of lookup candidates: the whole phrase,
# the first word, then light morphology on the first word so "running" resolves
# to "run", "berries" to "berry", etc.
declare -a cands=()
add_cand() { local c="$1"; [[ -n "$c" ]] || return; for e in "${cands[@]:-}"; do [[ "$e" == "$c" ]] && return; done; cands+=("$c"); }

add_cand "$norm"
add_cand "$first"
w="$first"
case "$w" in
  *ies) [[ ${#w} -gt 4 ]] && add_cand "${w%ies}y" ;;
esac
case "$w" in
  *sses|*shes|*ches|*xes|*zes) add_cand "${w%es}" ;;
  *es) [[ ${#w} -gt 3 ]] && add_cand "${w%s}"; [[ ${#w} -gt 3 ]] && add_cand "${w%es}" ;;
esac
case "$w" in
  *s) [[ ${#w} -gt 3 ]] && add_cand "${w%s}" ;;
esac
case "$w" in
  *ing) [[ ${#w} -gt 5 ]] && { add_cand "${w%ing}"; add_cand "${w%ing}e"; } ;;
esac
case "$w" in
  *ed) [[ ${#w} -gt 4 ]] && { add_cand "${w%ed}"; add_cand "${w%d}"; add_cand "${w%ed}e"; } ;;
esac
case "$w" in
  *ly) [[ ${#w} -gt 4 ]] && add_cand "${w%ly}" ;;
esac
case "$w" in
  *er) [[ ${#w} -gt 4 ]] && add_cand "${w%er}" ;;
  *est) [[ ${#w} -gt 5 ]] && add_cand "${w%est}" ;;
esac

# The selection with its original casing (punctuation stripped), and a Title
# Case form, for sources whose headwords are case-sensitive.
cased_phrase="$(printf '%s' "$raw_query" | "$TR" -c "A-Za-z0-9'’ -" ' ' | "$TR" -s ' ' | "$SED" -e 's/^ *//' -e 's/ *$//')"
cased_first="${cased_phrase%% *}"
title_phrase="$("$SED" -E 's/(^| )([a-z])/\1\u\2/g' <<<"$norm")"

sql_escape() { printf "%s" "$1" | "$SED" "s/'/''/g"; }

# ---- provider backends ---------------------------------------------------

# Ensure the runtime SQLite file exists, decompressing the shipped .xz on first
# use (or whenever the compressed source is newer). Echoes the runtime path.
ensure_sqlite() {
  local rel_db="$1" rel_src="$2"
  local src="$plugin_dir/$rel_src"
  local base; base="$("$BASENAME" -- "$rel_db")"
  local runtime="$cache_dir/$base"
  if [[ -f "$plugin_dir/$rel_db" ]]; then
    printf '%s' "$plugin_dir/$rel_db"; return 0          # uncompressed DB shipped
  fi
  [[ -f "$src" ]] || return 1

  # Refuse to operate through a symlinked cache directory (a swapped/planted link
  # could redirect our writes and reads elsewhere). Then lock it to 0700, ours.
  if [[ -L "$cache_dir" ]]; then return 1; fi
  "$MKDIR" -p -- "$cache_dir" || return 1
  [[ -d "$cache_dir" && ! -L "$cache_dir" ]] || return 1
  "$CHMOD" 700 -- "$cache_dir" 2>/dev/null || true

  # Never trust an existing runtime that is a symlink — a planted link could redirect
  # both our write and our later read (and its target's mtime could game the freshness
  # check below into skipping the rebuild). Drop it first, then rebuild from source.
  if [[ -L "$runtime" ]]; then "$RM" -f -- "$runtime"; fi

  # Rebuild only when the runtime copy is missing or older than the source.
  if [[ ! -f "$runtime" || "$src" -nt "$runtime" ]]; then
    # Reject before extracting if the archive header already advertises more than
    # the cap (a cheap decompression-bomb screen).
    local adv
    adv="$("$XZ" --robot -l -- "$src" 2>/dev/null | "$AWK" -F'\t' '$1=="file"{print $5; exit}')"
    if [[ -n "$adv" && "$adv" =~ ^[0-9]+$ && "$adv" -gt "$MAX_DB_BYTES" ]]; then
      return 1
    fi
    # Decompress into an unpredictable, O_EXCL temp file *inside* the locked cache
    # dir (mktemp will not follow a pre-planted symlink), then atomically rename.
    local tmp
    tmp="$("$MKTEMP" -- "$cache_dir/.${base}.XXXXXX")" || return 1
    # Hard byte cap as a backstop even if the header lied.
    if "$XZ" -dc -- "$src" | "$HEAD" -c "$MAX_DB_BYTES" >"$tmp" 2>/dev/null; then
      local got; got="$("$WC" -c <"$tmp")"
      if [[ "$got" -ge "$MAX_DB_BYTES" ]]; then    # hit the cap => truncated/bomb
        "$RM" -f -- "$tmp"; return 1
      fi
      [[ -L "$runtime" ]] && "$RM" -f -- "$runtime"   # never write through a link
      "$CHMOD" 600 -- "$tmp" 2>/dev/null || true
      "$MV" -f -- "$tmp" "$runtime"
    else
      "$RM" -f -- "$tmp"; return 1
    fi
  fi
  printf '%s' "$runtime"
}

# Query one sqlite-backed dictionary. Prints a JSON array of {headword,text}
# for the first candidate that hits; empty array if nothing matched.
query_sqlite() {
  local db="$1"; shift
  local c esc rows
  for c in "$@"; do
    esc="$(sql_escape "$c")"
    rows="$("$SQLITE3" "$db" \
      "SELECT json_group_array(json_object('headword', headword, 'text', definition)) \
       FROM (SELECT headword, definition FROM entries WHERE word='$esc' LIMIT 12);" 2>/dev/null || true)"
    if [[ -n "$rows" && "$rows" != "[]" && "$rows" != "null" ]]; then
      printf '%s' "$rows"; return 0
    fi
  done
  printf '[]'
}

# "Did you mean" suggestions from a sqlite dictionary. Tries the full word as a
# prefix, then backs off to shorter prefixes so a total miss ("serendipity")
# still surfaces near neighbors. Prints a JSON array (possibly empty).
suggest_sqlite() {
  local db="$1" c="$2" p esc out
  local n=${#c}
  for (( p=n; p>=4; p-- )); do
    esc="$(sql_escape "${c:0:p}")"
    out="$("$SQLITE3" "$db" \
      "SELECT json_group_array(word) FROM \
         (SELECT DISTINCT word FROM entries WHERE word LIKE '$esc%' ORDER BY length(word), word LIMIT 8);" \
      2>/dev/null || true)"
    if [[ -n "$out" && "$out" != "[]" && "$out" != "null" ]]; then
      printf '%s' "$out"; return 0
    fi
  done
  printf '[]'
}

# Fetch an https URL through a per-source response cache. Hits are kept for
# <ttl_days>; misses (404 etc.) for a day, so repeat lookups never wait on the
# network. Prints the body; returns 1 on a miss.
fetch_cached() {
  local sub="$1" ttl_days="$2" url="$3"
  local dir="$cache_dir/$sub" key file body tmp
  [[ -L "$cache_dir" || -L "$dir" ]] && return 1
  "$MKDIR" -p -- "$dir" 2>/dev/null && "$CHMOD" 700 -- "$cache_dir" "$dir" 2>/dev/null || true
  key="$(printf '%s' "$url" | "$SHA256SUM")"; file="$dir/${key%% *}"
  if [[ -f "$file.miss" && ! -L "$file.miss" && -n "$("$FIND" "$file.miss" -mtime -1 2>/dev/null)" ]]; then
    return 1
  fi
  if [[ -f "$file" && ! -L "$file" && -n "$("$FIND" "$file" -mtime -"$ttl_days" 2>/dev/null)" ]]; then
    printf '%s' "$(<"$file")"; return 0
  fi
  if body="$("$CURL" -fsS --proto =https --max-time 3 --max-filesize 8388608 -- "$url" 2>/dev/null)" && [[ -n "$body" ]]; then
    tmp="$("$MKTEMP" -- "$dir/.fetch.XXXXXX" 2>/dev/null)" && printf '%s' "$body" >"$tmp" && "$MV" -f -- "$tmp" "$file"
    printf '%s' "$body"; return 0
  fi
  : >"$file.miss" 2>/dev/null || true
  return 1
}

# Query Kaikki.org's machine-readable Wiktionary for definitions, morpheme
# breakdown and etymology. Tries at most <max_tries> candidates so a miss stays
# inside the popup's lookup watchdog. Prints a JSON array (possibly empty).
kaikki_url() {  # <base> <word>
  local enc p1 p2
  enc="$("$JQ" -rn --arg s "$2" '$s|@uri')"
  p1="$("$JQ" -rn --arg s "$2" '$s[0:1]|@uri')"; p2="$("$JQ" -rn --arg s "$2" '$s[0:2]|@uri')"
  printf '%s/%s/%s/%s.jsonl' "$1" "$p1" "$p2" "$enc"
}
query_kaikki() {
  local base="$1" ttl_days="$2" max_tries="$3"; shift 3
  local c raw out lemma lraw lout tries=0
  for c in "$@"; do
    (( tries++ < max_tries )) || break
    raw="$(fetch_cached kaikki "$ttl_days" "$(kaikki_url "$base" "$c")")" || continue
    out="$("$JQ" -cs --arg word "$c" -f "$plugin_dir/scripts/kaikki.jq" <<<"$raw" 2>/dev/null || true)"
    # An inflection ("berries" = "plural of berry") carries no etymology of its
    # own, so append the lemma's entries when every sense is a form-of.
    lemma="$("$JQ" -rs '[.[].senses[]?] as $s
      | if ($s|length) > 0 and all($s[]; .form_of) then $s[0].form_of[0].word // "" else "" end' <<<"$raw" 2>/dev/null || true)"
    if [[ -n "$lemma" && "$lemma" != "$c" && -n "$out" ]] \
      && lraw="$(fetch_cached kaikki "$ttl_days" "$(kaikki_url "$base" "$lemma")")"; then
      lout="$("$JQ" -cs --arg word "$lemma" -f "$plugin_dir/scripts/kaikki.jq" <<<"$lraw" 2>/dev/null || true)"
      [[ -n "$lout" ]] && out="$("$JQ" -cn --argjson a "$out" --argjson b "$lout" '$a + $b' 2>/dev/null || printf '%s' "$out")"
    fi
    if [[ -n "$out" && "$out" != "[]" && "$out" != "null" ]]; then
      printf '%s' "$out"; return 0
    fi
  done
  printf '[]'
}

# Wikipedia page summary, for the proper nouns (companies, places, people) a
# dictionary lacks. Disambiguation pages are skipped. Prints a JSON array.
query_wikipedia() {
  local base="$1" ttl_days="$2"; shift 2
  local t raw out
  for t in "$@"; do
    [[ -n "$t" ]] || continue
    raw="$(fetch_cached wikipedia "$ttl_days" "$base/$("$JQ" -rn --arg s "$t" '$s|gsub(" ";"_")|@uri')")" || continue
    out="$("$JQ" -c 'select(.type == "standard" and (.extract // "") != "")
      | [{headword: (.title + (if .description then " · " + .description else "" end)), text: .extract}]' \
      <<<"$raw" 2>/dev/null || true)"
    if [[ -n "$out" && "$out" != "[]" ]]; then printf '%s' "$out"; return 0; fi
  done
  printf '[]'
}

# Results for one online provider, by its descriptor. Prints a JSON array.
query_online() {
  local desc="$1" kind base ttl
  kind="$("$JQ" -r '.kind // ""' "$desc")"
  base="$("$JQ" -r '.base // ""' "$desc")"
  ttl="$("$JQ" -r '.cacheDays // 30' "$desc")"
  [[ "$base" == https://* && "$ttl" =~ ^[0-9]+$ ]] || { printf '[]'; return 0; }
  case "$kind" in
    kaikki)
      # Proper nouns live under their capitalized headword ("Paris" the city,
      # "paris" the plant), so try the selection's own casing first, then the
      # lowercase candidates, and show both.
      local cased='[]' lower
      [[ "$cased_phrase" != "$norm" ]] && cased="$(query_kaikki "$base" "$ttl" 2 "$cased_phrase" "$cased_first")"
      lower="$(query_kaikki "$base" "$ttl" 3 "${cands[@]}")"
      "$JQ" -cn --argjson a "$cased" --argjson b "$lower" '$a + $b'
      ;;
    wikipedia)
      query_wikipedia "$base" "$ttl" "$cased_phrase" "$title_phrase"
      ;;
    *) printf '[]' ;;
  esac
}

# ---- read provider order -------------------------------------------------
order_json='["webster1913"]'
for f in "$defaults" "$user_config"; do
  [[ -f "$f" && ! -L "$f" ]] || continue
  o="$("$JQ" -c '.sources | select(type == "array")' "$f" 2>/dev/null || true)"
  [[ -n "$o" ]] && order_json="$o"
done
mapfile -t providers < <("$JQ" -r '.[]' <<<"$order_json" 2>/dev/null || printf 'webster1913\n')

# ---- consult each provider ----------------------------------------------
sections='[]'
suggestions='[]'
any_found=0

# Online providers run in parallel so their latencies don't add up.
work="$("$MKTEMP" -d)"; trap '"$RM" -rf -- "$work"' EXIT
for pid in "${providers[@]}"; do
  desc="$plugin_dir/providers/$pid.json"
  [[ -n "$pid" && "$pid" != */* && -f "$desc" ]] || continue
  case "$("$JQ" -r '.kind // ""' "$desc")" in
    kaikki|wikipedia) query_online "$desc" >"$work/$pid" & ;;
  esac
done
wait

for pid in "${providers[@]}"; do
  [[ -n "$pid" && "$pid" != */* ]] || continue
  desc="$plugin_dir/providers/$pid.json"
  [[ -f "$desc" ]] || continue
  name="$("$JQ" -r '.name // .id' "$desc")"
  kind="$("$JQ" -r '.kind // ""' "$desc")"
  entries='[]'

  case "$kind" in
    sqlite)
      rel_db="$("$JQ" -r '.db // ""' "$desc")"
      rel_src="$("$JQ" -r '.source // ""' "$desc")"
      if db="$(ensure_sqlite "$rel_db" "$rel_src")" && [[ -n "$db" ]]; then
        entries="$(query_sqlite "$db" "${cands[@]}")"
        if [[ "$entries" == "[]" && "$suggestions" == "[]" ]]; then
          suggestions="$(suggest_sqlite "$db" "$first")"
          [[ -z "$suggestions" || "$suggestions" == "null" ]] && suggestions='[]'
        fi
      fi
      ;;
    kaikki|wikipedia)
      entries="$(<"$work/$pid")"
      "$JQ" -e 'type == "array"' <<<"$entries" >/dev/null 2>&1 || entries='[]'
      ;;
    *)
      entries='[]'
      ;;
  esac

  if [[ "$entries" != "[]" && "$entries" != "null" ]]; then
    any_found=1
  fi
  sections="$("$JQ" -c --arg id "$pid" --arg name "$name" --argjson entries "$entries" \
    '. + [{id:$id, name:$name, entries:$entries}]' <<<"$sections")"
done

found=false; [[ "$any_found" == 1 ]] && found=true

"$JQ" -cn \
  --arg q "$raw_query" \
  --arg word "$first" \
  --argjson found "$found" \
  --argjson sections "$sections" \
  --argjson suggestions "$suggestions" \
  '{query:$q, word:$word, found:$found, sections:$sections, suggestions:$suggestions}'
