#!/usr/bin/env bash
# Word Tap: read the word under the mouse pointer off the screen (OCR) and open
# it in the popup. Nothing is clicked or selected in the app underneath.
# Run by scripts/tap-watch on a three-finger tap; also fine to bind to a key.
#
# Highlight a phrase first and tap on it to look up the whole phrase: when the
# highlighted text (the primary selection) is 2-8 words and the line under the
# pointer reads the same around the tapped word, the phrase is looked up instead.
#
#   lookup-at-cursor                      the word under the pointer
#   lookup-at-cursor X Y                  the word at screen point X,Y
#   lookup-at-cursor X Y SHOT.png < SEL   testing: SHOT.png stands in for the screen
#                                         and SEL for the highlight; prints the query
#
# Requires: grim, imagemagick (magick), tesseract + tesseract-data-eng, wl-paste, jq, iconv.
set -uo pipefail
# A UTF-8 locale, whatever the user's, so awk compares "Hôtel" letter by letter.
export LC_ALL=C.UTF-8

W=500 H=70 SCALE=3   # capture box around the cursor (px) and OCR upscale
MAX_DIST=10          # how far (screen px) the cursor may be from a word
MAX_PHRASE_WORDS=8   # longest highlighted phrase a tap picks up

tmp="$(mktemp -d)"; trap 'rm -rf -- "$tmp"' EXIT

if (( $# >= 2 )); then cx=$1 cy=$2; else read -r cx cy < <(hyprctl cursorpos | tr -d ,); fi

# Keep the capture box on the monitor under the pointer (logical px): a box hanging off an
# edge comes back short, or not at all, and stretching it would misplace the pointer.
if (( $# == 3 )); then
  mx=0 my=0; read -r mw mh < <(magick identify -format '%w %h' "$3")
else
  read -r mx my mw mh < <(hyprctl monitors -j | WT_X="$cx" WT_Y="$cy" jq -r '
    ($ENV.WT_X | tonumber) as $x | ($ENV.WT_Y | tonumber) as $y
    | map(if .transform % 2 == 1 then {x, y, w: (.height / .scale), h: (.width / .scale)}
        else {x, y, w: (.width / .scale), h: (.height / .scale)} end
        | .w |= floor | .h |= floor)
    | (map(select($x >= .x and $x < .x + .w and $y >= .y and $y < .y + .h)) + [{x: 0, y: 0, w: 1e9, h: 1e9}])[0]
    | "\(.x) \(.y) \(.w) \(.h)"')
fi
(( W > mw )) && W=$mw; (( H > mh )) && H=$mh
x0=$(( cx - W / 2 )); (( x0 > mx + mw - W )) && x0=$(( mx + mw - W )); (( x0 < mx )) && x0=$mx
y0=$(( cy - H / 2 )); (( y0 > my + mh - H )) && y0=$(( my + mh - H )); (( y0 < my )) && y0=$my
if (( $# == 3 )); then
  magick "$3" -crop "${W}x${H}+${x0}+${y0}" +repage "$tmp/shot.png" || exit 0
else
  grim -g "$x0,$y0 ${W}x${H}" "$tmp/shot.png" 2>/dev/null || exit 0
fi

# OCR <image> in language <lang> and pick the word box containing the cursor, else the
# nearest one within reach. Prints "<word>\t<its index in the line>\t<line>\t<confidence>\t<box>",
# the line being every word level with it, left to right, and the box "left right" on screen. <image> covers the screen from
# <ox>,<oy> (default: the capture box) at SCALE; <tessdata> is an extra model directory.
pick() {
  local ox=${3:-$x0} oy=${4:-$y0} dirs=()
  [[ -n "${5:-}" ]] && dirs=(--tessdata-dir "$5")
  OMP_THREAD_LIMIT=1 tesseract "$1" - "${dirs[@]}" -l "$2" --psm 11 -c tessedit_create_tsv=1 2>/dev/null | awk -F'\t' \
    -v px=$(( (cx - ox) * SCALE )) -v py=$(( (cy - oy) * SCALE )) -v max=$(( MAX_DIST * SCALE )) \
    -v ox="$ox" -v scale="$SCALE" '
    # Every word counts as line context; only a confident one can be the tapped word.
    NR > 1 && $12 ~ /[[:alnum:]]/ && $11 >= 0 {
      n++; L[n] = $7; R[n] = $7 + $9; T[n] = $8; B[n] = $8 + $10; X[n] = $12; C[n] = $11
      if ($12 !~ /[[:alpha:]]/ || $11 <= 40) next
      l = $7; t = $8; r = $7 + $9; b = $8 + $10
      dx = px < l ? l - px : (px > r ? px - r : 0)
      dy = py < t ? t - py : (py > b ? py - b : 0)
      d = dx + dy
      if (d <= max && (best == "" || d < bd)) { bd = d; best = n }
    }
    END {
      if (best == "") exit
      for (i = 1; i <= n; i++) {
        c = (T[i] + B[i]) / 2
        if (c >= T[best] && c <= B[best]) k[sprintf("%08d %d", L[i], i)] = i
      }
      m = asorti(k, s); line = ""
      for (j = 1; j <= m; j++) { line = line (j > 1 ? " " : "") X[k[s[j]]]; if (k[s[j]] == best) at = j }
      print X[best] "\t" at "\t" line "\t" C[best] "\t" int(ox + L[best] / scale) " " int(ox + R[best] / scale)
    }'
}

# OCR languages: "ocrLanguages" in the config, by default English; "auto" is every installed
# Tesseract pack. At most four, each run in parallel, the most confident reading winning. Extra
# packs are for other scripts (rus, ell, ...): for accented Latin letters, use the Latin-script
# model below, since rival Latin packs disagree confidently ("schôn" from French for "schön").
langs_cfg="eng"
for f in "$(dirname "${BASH_SOURCE[0]}")/../defaults.json" "${XDG_CONFIG_HOME:-$HOME/.config}/wordtap/config.json"; do
  [[ -f "$f" && ! -L "$f" ]] || continue
  v="$(jq -r '.ocrLanguages | if type == "array" then join("+") elif type == "string" then . else empty end' "$f" 2>/dev/null)"
  [[ -n "$v" ]] && langs_cfg="$v"
done
if [[ "$langs_cfg" == auto ]]; then
  mapfile -t langs < <(tesseract --list-langs 2>/dev/null | grep -vE '^(List of|osd$|equ$)|_vert$' | sort -u | awk '$0 == "eng" { print; next } { rest = rest $0 "\n" } END { printf "%s", rest }')
else
  IFS=+ read -ra langs <<<"$langs_cfg"
fi
langs=("${langs[@]:0:4}"); (( ${#langs[@]} )) || langs=(eng)

# Two readings, in parallel, each in every language. Plain: inverted for dark themes, since
# Tesseract wants dark text on light. Local: each pixel's distance from its neighbourhood's
# median, which reads text of either polarity, so it also gets highlighted text that is
# inverted against the rest.
mean="$(magick "$tmp/shot.png" -colorspace gray -format '%[fx:mean]' info:)"
negate=(); awk -v m="$mean" 'BEGIN { exit !(m < 0.5) }' && negate=(-negate)
magick "$tmp/shot.png" -colorspace gray "${negate[@]}" -resize "$(( W * SCALE ))x$(( H * SCALE ))!" "$tmp/plain.png"
magick "$tmp/shot.png" -colorspace gray \( +clone -statistic median 11x11 \) -compose difference -composite \
  -auto-level -negate -resize "$(( W * SCALE ))x$(( H * SCALE ))!" "$tmp/local.png"
for lang in "${langs[@]}"; do
  [[ "$lang" =~ ^[A-Za-z_]+$ ]] || continue
  pick "$tmp/plain.png" "$lang" >"$tmp/plain.$lang" & pick "$tmp/local.png" "$lang" >"$tmp/local.$lang" &
done

# Accents: with Tesseract's Latin-script model installed (scripts/ocr-accents enable), also read
# a small box around the pointer with it. It knows every Latin alphabet's letters but reads
# English a little worse, so below it only restores accents to the word English read.
accent_dir="${XDG_DATA_HOME:-$HOME/.local/share}/wordtap/tessdata"
if [[ -f "$accent_dir/Latin.traineddata" ]]; then
  AW=240 AH=40; (( AW > W )) && AW=$W; (( AH > H )) && AH=$H
  ax=$(( cx - AW / 2 )); (( ax > x0 + W - AW )) && ax=$(( x0 + W - AW )); (( ax < x0 )) && ax=$x0
  ay=$(( cy - AH / 2 )); (( ay > y0 + H - AH )) && ay=$(( y0 + H - AH )); (( ay < y0 )) && ay=$y0
  magick "$tmp/plain.png" -crop "$(( AW * SCALE ))x$(( AH * SCALE ))+$(( (ax - x0) * SCALE ))+$(( (ay - y0) * SCALE ))" \
    +repage "$tmp/accent.png" && pick "$tmp/accent.png" Latin "$ax" "$ay" "$accent_dir" >"$tmp/accent" &
fi
wait

# The plain reading is the more accurate one for ordinary text; the local one fills in. Across
# languages, the most confident reading wins (English first on a tie).
best_pick() {  # <plain|local>: sets word/at/line from that reading's most confident language
  local f w a l c x bc=-1
  for lang in "${langs[@]}"; do
    f="$tmp/$1.$lang"
    [[ -s "$f" ]] && IFS=$'\t' read -r w a l c x <"$f" && [[ -n "$w" ]] || continue
    if awk -v c="$c" -v b="$bc" 'BEGIN { exit !(c + 0 > b + 0) }'; then word=$w at=$a line=$l box=$x bc=$c; fi
  done
  [[ "$bc" != -1 ]]
}
best_pick plain || best_pick local || { [[ -s "$tmp/accent" ]] && IFS=$'\t' read -r word at line _ box <"$tmp/accent"; } || exit 0

# Edit distance, for comparing OCR readings.
LEV='function lev(a, b,   i, j, la, lb, p, c, t) {
  la = length(a); lb = length(b)
  for (j = 0; j <= lb; j++) p[j] = j
  for (i = 1; i <= la; i++) {
    c[0] = i
    for (j = 1; j <= lb; j++) {
      t = p[j - 1] + (substr(a, i, 1) != substr(b, j, 1))
      if (p[j] + 1 < t) t = p[j] + 1
      if (c[j - 1] + 1 < t) t = c[j - 1] + 1
      c[j] = t
    }
    for (j = 0; j <= lb; j++) p[j] = c[j]
  }
  return p[lb]
}'

# Take the Latin model's spelling when it has accents and is the same word: the same place on
# screen, and close once accents are stripped (English OCR turns "grün" into "griin", "Fluß"
# into "FluB"). So accents are restored ("Letzebuergesch" -> "Lëtzebuergesch"), never another word.
fold() { iconv -f utf-8 -t ascii//TRANSLIT 2>/dev/null | tr '[:upper:]' '[:lower:]' | tr -cd '[:alnum:]'; }
if [[ -s "$tmp/accent" ]] && IFS=$'\t' read -r aword _ _ _ abox <"$tmp/accent" && [[ -n "$aword" && "$aword" == *[![:ascii:]]* ]] \
  && WT_A="$(printf '%s' "$aword" | fold)" WT_B="$(printf '%s' "$word" | fold)" awk -v abox="$abox" -v box="${box:-}" "$LEV"'
    BEGIN {
      split(abox, p, " "); split(box, q, " ")
      overlap = (p[2] < q[2] ? p[2] : q[2]) - (p[1] > q[1] ? p[1] : q[1])
      narrow = (p[2] - p[1] < q[2] - q[1]) ? p[2] - p[1] : q[2] - q[1]
      a = ENVIRON["WT_A"]; b = ENVIRON["WT_B"]; n = length(a)
      exit !(n > 0 && narrow > 0 && overlap >= narrow / 2 && lev(a, b) <= int(n / 2))
    }'; then
  word="$aword"
fi

# Trim surrounding punctuation ("(word)," -> "word"), keep inner ' and -.
trim() { sed -E "s/^[^[:alnum:]]+//; s/[^[:alnum:]]+$//"; }
query="$(trim <<<"$word")"
[[ -n "$query" ]] || exit 0

# A highlighted phrase wins only if the tap landed on it: some run of words in the line,
# including the tapped one, reads as the phrase (allowing OCR slips: one character in four),
# so a stale highlight elsewhere never takes over.
if (( $# == 3 )); then sel="$(head -c 400)"
else sel="$(timeout 1 wl-paste --primary --no-newline --type text/plain 2>/dev/null | head -c 400)"; fi
sel="$(printf '%s' "$sel" | tr '\n\t' '  ' | tr -s ' ' | sed -e 's/^ //' -e 's/ $//')"
phrase_at() {  # <pick file>: succeeds when the highlight matches there. The text goes via the environment.
  [[ -s "$1" ]] || return 1
  WT_SEL="$sel" awk -F'\t' -v maxw="$MAX_PHRASE_WORDS" "$LEV"'
    function squash(x) { x = tolower(x); gsub(/[^[:alnum:]]+/, " ", x); gsub(/^ | $/, "", x); return x }
    {
      want = squash(ENVIRON["WT_SEL"]); k = split(want, s, " ")
      if (k < 2 || k > maxw) exit 1
      budget = int(length(want) / 4); if (budget < 1) budget = 1
      # Line words, each mapped back from its squashed tokens to the original word index.
      n = 0; split($3, words, " ")
      for (w = 1; w in words; w++) {
        m = split(squash(words[w]), parts, " ")
        for (q = 1; q <= m; q++) { n++; tok[n] = parts[q]; of[n] = w }
      }
      # Runs of k-1..k+1 words (OCR splits and merges words) that include the tapped one.
      for (size = k - 1; size <= k + 1; size++) {
        if (size < 1) continue
        for (i = 1; i + size - 1 <= n; i++) {
          if (!(of[i] <= $2 && $2 <= of[i + size - 1])) continue
          got = tok[i]; for (j = i + 1; j < i + size; j++) got = got " " tok[j]
          if (lev(want, got) <= budget) exit 0
        }
      }
      exit 1
    }' "$1"
}
if [[ -n "$sel" ]]; then
  for f in "$tmp"/plain.* "$tmp"/local.* "$tmp/accent"; do
    [[ "$f" == *.png ]] && continue
    if phrase_at "$f"; then query="$sel"; break; fi
  done
fi

if (( $# == 3 )); then printf '%s\n' "$query"; exit 0; fi

# Through stdin and a private file, never a command line (see scripts/summon).
printf '%s' "$query" | "$(dirname "${BASH_SOURCE[0]}")/summon"
